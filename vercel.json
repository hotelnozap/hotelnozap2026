{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/web-app-origin-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/lp",
      "destination": "https://lp.hotelnozap.com.br",
      "permanent": false
    },
    {
      "source": "/lp/:path*",
      "destination": "https://lp.hotelnozap.com.br/:path*",
      "permanent": false
    },
    {
      "source": "/parceiros",
      "destination": "https://parceiros.hotelnozap.com.br",
      "permanent": false
    },
    {
      "source": "/login",
      "has": [
        {
          "type": "host",
          "value": "app.hotelnozap.com.br"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/hoteis/cardapio/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/hoteis/:slug",
      "destination": "/api/hotel-og?slug=:slug"
    },
    {
      "source": "/hotel/:slug",
      "destination": "/api/hotel-og?slug=:slug"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.hotelnozap.com.br"
        }
      ],
      "destination": "/api/subdomain-og?portal=app"
    },
    {
      "source": "/((?!assets/|favicon|_vercel|sw\\.js|manifest\\.json|robots\\.txt|sitemap\\.xml|apple-touch-icon|logo|icon|.*\\.(?:png|jpg|jpeg|gif|svg|ico|js|css|json|xml|txt|woff2?|ttf|map)).*)",
      "has": [
        {
          "type": "host",
          "value": "app.hotelnozap.com.br"
        }
      ],
      "destination": "/api/subdomain-og?portal=app"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lp.hotelnozap.com.br"
        }
      ],
      "destination": "/api/subdomain-og?portal=lp"
    },
    {
      "source": "/((?!assets/|favicon|_vercel|sw\\.js|manifest\\.json|robots\\.txt|sitemap\\.xml|apple-touch-icon|logo|icon|.*\\.(?:png|jpg|jpeg|gif|svg|ico|js|css|json|xml|txt|woff2?|ttf|map)).*)",
      "has": [
        {
          "type": "host",
          "value": "lp.hotelnozap.com.br"
        }
      ],
      "destination": "/api/subdomain-og?portal=lp"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "parceiros.hotelnozap.com.br"
        }
      ],
      "destination": "/api/subdomain-og?portal=parceiros"
    },
    {
      "source": "/((?!assets/|favicon|_vercel|sw\\.js|manifest\\.json|robots\\.txt|sitemap\\.xml|apple-touch-icon|logo|icon|.*\\.(?:png|jpg|jpeg|gif|svg|ico|js|css|json|xml|txt|woff2?|ttf|map)).*)",
      "has": [
        {
          "type": "host",
          "value": "parceiros.hotelnozap.com.br"
        }
      ],
      "destination": "/api/subdomain-og?portal=parceiros"
    },
    {
      "source": "/(login|paineladmin)",
      "destination": "/api/subdomain-og?portal=app"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
