{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/lp",
      "destination": "https://lp.hotelnozap.com.br",
      "permanent": false
    },
    {
      "source": "/lp/:path*",
      "destination": "https://lp.hotelnozap.com.br/:path*",
      "permanent": false
    },
    {
      "source": "/parceiros",
      "destination": "https://parceiros.hotelnozap.com.br",
      "permanent": false
    },
    {
      "source": "/(index\\.html)?",
      "has": [
        {
          "type": "host",
          "value": "app.hotelnozap.com.br"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|telegrambot|twitterbot|linkedinbot|slackbot|discordbot|applebot|googlebot|bingbot|crawler|spider|bot).*"
        }
      ],
      "destination": "/api/app-og",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/hoteis/cardapio/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/hoteis/:slug",
      "destination": "/api/hotel-og?slug=:slug"
    },
    {
      "source": "/hotel/:slug",
      "destination": "/api/hotel-og?slug=:slug"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.hotelnozap.com.br"
        }
      ],
      "destination": "/api/app-og"
    },
    {
      "source": "/((?!assets/|favicon|_vercel|sw\\.js|manifest\\.json|apple-touch-icon|logo|icon|.*\\.(?:png|jpg|jpeg|gif|svg|ico|js|css|json|woff2?|ttf|map)).*)",
      "has": [
        {
          "type": "host",
          "value": "app.hotelnozap.com.br"
        }
      ],
      "destination": "/api/app-og"
    },
    {
      "source": "/(login|paineladmin)",
      "destination": "/api/app-og"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
