        "jsCode": "const bufferContent = $input.first()?.json?.propertyName || '';\nlet fallback = '';\nlet pushName = 'Parceiro';\nlet primeiroNome = 'Parceiro';\n\ntry {\n  const norm = $('Normalizar Dados').first()?.json;\n  if (norm) {\n    fallback = norm.mensagem || '';\n    pushName = norm.pushName || 'Parceiro';\n    primeiroNome = norm.primeiroNome || 'Parceiro';\n  }\n} catch (e) {}\n\nconst mensagemCompleta = (bufferContent && bufferContent.trim().length > 0)\n  ? bufferContent.trim()\n  : fallback.trim();\n\nreturn [{\n  json: {\n    instance: 'meutim',\n    telefone: $('Normalizar Dados').item.json.telefone,\n    pushName,\n    primeiroNome,\n    mensagemCompleta\n  }\n}];"
