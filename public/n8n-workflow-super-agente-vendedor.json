    {
      "parameters": {
        "jsCode": "const body = $input.first()?.json?.body || $input.first()?.json || {};\nconst data = body.data || body;\n\nconst fromMe = data.key?.fromMe === true || body.fromMe === true;\nconst remoteJid = data.key?.remoteJid || body.remoteJid || '';\n\nif (remoteJid.includes('@g.us') || remoteJid.includes('broadcast') || remoteJid.includes('@newsletter')) {\n  return [];\n}\n\nconst rawNumber = remoteJid ? remoteJid.split('@')[0] : (data.key?.participant || '').split('@')[0];\nconst cleanPhone = rawNumber ? rawNumber.replace(/\\D/g, '') : '';\nif (!cleanPhone) {\n  return [];\n}\n\nconst msgObj = data.message || body.message || {};\nlet text = '';\nlet messageType = 'texto';\n\nif (data.messageType === 'conversation' || msgObj.conversation) {\n  text = msgObj.conversation || '';\n} else if (data.messageType === 'extendedTextMessage' || msgObj.extendedTextMessage) {\n  text = msgObj.extendedTextMessage?.text || '';\n} else if (data.messageType === 'audioMessage' || msgObj.audioMessage) {\n  messageType = 'voz';\n}\n\nconst pushName = data.pushName || body.pushName || 'Parceiro';\nconst primeiroNome = pushName.split(' ')[0] || 'Parceiro';\n\n// CASO 1: Mensagem enviada pelo próprio Everaldo (fromMe: true)\nif (fromMe) {\n  const comando = text.trim().toLowerCase();\n  const isReativar = comando === '#ia' || comando === '#ativar' || comando === 'ativar ia';\n  return [{\n    json: {\n      fromMe: true,\n      acao: isReativar ? 'reativar' : 'pausar',\n      telefone: cleanPhone,\n      mensagem: text.trim()\n    }\n  }];\n}\n\n// CASO 2: Mensagem enviada pelo CLIENTE (fromMe: false)\nreturn [{\n  json: {\n    fromMe: false,\n    instanceName: 'meutim',\n    tipo: messageType,\n    telefone: cleanPhone,\n    pushName,\n    primeiroNome,\n    mensagem: text.trim(),\n    mimetype: msgObj.audioMessage?.mimetype || 'audio/ogg',\n    base64: '',\n    rawMessage: msgObj,\n    messageId: data.key?.id || String(Date.now()),\n    timestamp: Date.now()\n  }\n}];"
      },
