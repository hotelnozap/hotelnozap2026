        "jsCode": "const prevData = $('Normalizar Dados').first()?.json || {};\nconst item = $input.first()?.json || {};\n\nconst base64Data = item.base64 || item.data?.base64 || prevData.base64 || '';\nconst mimeType = item.mimetype || item.data?.mimetype || 'audio/ogg';\n\nconst binaryData = {\n  data: base64Data,\n  mimeType: mimeType,\n  fileName: 'audio.ogg'\n};\n\nreturn [{\n  json: {\n    ...prevData,\n    base64Loaded: Boolean(base64Data)\n  },\n  binary: {\n    file: binaryData,\n    data: binaryData\n  }\n}];"
