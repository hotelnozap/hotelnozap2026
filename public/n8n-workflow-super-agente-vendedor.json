    {
      "parameters": {
        "jsCode": "let current = '';\nlet info = $('Normalizar Dados').first()?.json || {};\n\ntry {\n  const voz = $('Definir Mensagem Transcrita').first()?.json;\n  if (voz && voz.mensagem) {\n    info = voz;\n    current = voz.mensagem;\n  }\n} catch (e) {}\n\nif (!current) {\n  current = info.mensagem || '';\n}\n\nconst prev = $input.first()?.json?.propertyName ?? $input.first()?.json?.value ?? '';\nconst combined = (prev && typeof prev === 'string' && prev.trim().length > 0)\n  ? `${prev.trim()} ${current.trim()}`\n  : current.trim();\n\nreturn [{\n  json: {\n    ...info,\n    mensagemBuffer: combined\n  }\n}];"
      },
