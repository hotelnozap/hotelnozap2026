        "jsCode": "const prevData = $('Normalizar Dados').first()?.json || {};\nconst whisperResult = $input.first()?.json || {};\n\nconst transcrito = whisperResult.text ? String(whisperResult.text).trim() : '';\nconst textoFinal = transcrito.length > 0 ? transcrito : '[Mensagem de áudio]';\n\nreturn [{\n  json: {\n    ...prevData,\n    mensagem: textoFinal,\n    transcricaoVoz: transcrito,\n    isAudioTranscribed: true\n  }\n}];"
