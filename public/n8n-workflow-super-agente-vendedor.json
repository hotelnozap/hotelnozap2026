        "jsCode": "const agentOutput = $input.first().json.output || $input.first().json.text || '';\nconst hotelInfo = $('Agrupar Mensagens em Uma').first().json;\nconst textoRecebido = (hotelInfo.mensagemCompleta || '').toLowerCase();\n\n// Detecta se é lead quente ou se o link foi enviado\nconst contemLink = agentOutput.includes('hotelnozap.com.br');\nconst pediuPrecoOuLink = textoRecebido.includes('preço') ||\n  textoRecebido.includes('preco') ||\n  textoRecebido.includes('valor') ||\n  textoRecebido.includes('quanto custa') ||\n  textoRecebido.includes('como funciona') ||\n  textoRecebido.includes('link') ||\n  textoRecebido.includes('quero testar') ||\n  textoRecebido.includes('cadastro');\n\nconst leadQuente = contemLink || pediuPrecoOuLink;\n\nconst mensagemAlertaEveraldo = `🚨 *LEAD QUENTE - HOTEL NO ZAP!*\\n\\n📱 *Lead:* ${hotelInfo.pushName} (${hotelInfo.telefone})\\n💬 *Disse:* \"${hotelInfo.mensagemCompleta}\"\\n🎯 *Status:* ${contemLink ? 'Link da LP enviado pela IA!' : 'Demonstrou interesse comercial!'}\\n\\n👉 *Falar com ele no WhatsApp:*\\nhttps://wa.me/${hotelInfo.telefone}`;\n\nreturn [{\n  json: {\n    telefone: hotelInfo.telefone,\n    pushName: hotelInfo.pushName,\n    primeiroNome: hotelInfo.primeiroNome,\n    resposta: agentOutput.trim(),\n    leadQuente,\n    mensagemAlertaEveraldo,\n    adminWhatsapp: '5565996173004'\n  }\n}];"
      },
